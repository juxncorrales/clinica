<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="361.0" prefWidth="465.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.clinica.controladores.CrearCitaControlador">

    <Label layoutX="58.0" layoutY="67.0" text="Paciente:" AnchorPane.leftAnchor="58.0" AnchorPane.topAnchor="67.0" />
    <TextField fx:id="pacientetxt" layoutX="208.0" layoutY="63.0" prefHeight="26.0" prefWidth="228.0" AnchorPane.leftAnchor="208.0" AnchorPane.topAnchor="63.0" />

    <Label layoutX="60.0" layoutY="104.0" text="Servicio:" AnchorPane.leftAnchor="60.0" AnchorPane.topAnchor="104.0" />
    <ComboBox fx:id="comboServicio" layoutX="208.0" layoutY="99.0" prefHeight="26.0" prefWidth="228.0" AnchorPane.leftAnchor="208.0" AnchorPane.topAnchor="99.0">
        <!-- Opciones de exámenes médicos en el ComboBox -->
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="Consulta General" />
                <String fx:value="Odontología" />
                <String fx:value="Cardiología" />
                <String fx:value="Laboratorio Clínico" />
                <String fx:value="Radiografía" />
                <String fx:value="Ecografía" />
                <String fx:value="Tomografía" />
                <String fx:value="Resonancia Magnética" />
                <String fx:value="Examen de Sangre" />
                <String fx:value="Electrocardiograma" />
                <String fx:value="Endoscopia" />
            </FXCollections>
        </items>
    </ComboBox>

    <Label layoutX="65.0" layoutY="147.0" text="Fecha:" AnchorPane.leftAnchor="65.0" AnchorPane.topAnchor="147.0" />
    <DatePicker fx:id="fechaDate" layoutX="208.0" layoutY="142.0" prefHeight="26.0" prefWidth="228.0" AnchorPane.leftAnchor="208.0" AnchorPane.topAnchor="142.0" />

    <Label layoutX="67.0" layoutY="187.0" text="Hora:" AnchorPane.leftAnchor="67.0" AnchorPane.topAnchor="187.0" />
    <TextField fx:id="horatxt" layoutX="208.0" layoutY="183.0" prefHeight="26.0" prefWidth="228.0" AnchorPane.leftAnchor="208.0" AnchorPane.topAnchor="183.0" />

    <Button fx:id="btnconfirmarCita" layoutX="186.0" layoutY="256.0" onAction="#registrarCita" text="Confirmar Cita" AnchorPane.leftAnchor="186.0" AnchorPane.topAnchor="256.0" />

    <Label layoutX="174.0" layoutY="14.0" text="Agendar Cita" AnchorPane.leftAnchor="174.0" AnchorPane.topAnchor="14.0">
        <font>
            <Font size="20.0" />
        </font>
    </Label>

</AnchorPane>
